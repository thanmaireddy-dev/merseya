# Merseya environment variables: TEMPLATE ONLY, safe to commit.
#
# 1. Copy this file to `.env` (git-ignored) in the project root.
# 2. Replace the placeholders with real values. Never commit `.env`,
#    never paste real values into chat, issues or screenshots.
# 3. Vercel gets its own copies of these values in Project Settings
#    -> Environment Variables (task 2.6).
#
# Variables are validated at startup by src/lib/env.ts.

# --- Database: Neon (task 2.4) -------------------------------------------
# Neon dashboard -> Connect -> Branch: dev
# Pooled connection ("Connection pooling" ON, host contains -pooler):
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Direct connection ("Connection pooling" OFF), used for migrations:
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# --- Images: Cloudinary (task 2.5, not required yet) ---------------------
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# --- Payments: Stripe test mode (Phase 4, not required yet) --------------
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Email: Resend (Phase 4, not required yet) ---------------------------
# RESEND_API_KEY=""
