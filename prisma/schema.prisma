// Merseya database schema. Design rationale: plan.md §10.
// Conventions:
//  - Money is ALWAYS integer cents in CAD (never Float).
//  - Products are deactivated (isActive = false), never deleted: orders reference them.
//  - Order items store SNAPSHOTS so past orders never change when prices or names do.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Catalogue ──────────────────────────────────────────────────────────────

model Category {
  id          String            @id @default(cuid())
  slug        String            @unique // used in the URL: /collections/<slug>
  name        String
  description String?
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  products    ProductCategory[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Product {
  id           String            @id @default(cuid())
  slug         String            @unique // /products/<slug>
  name         String
  description  String
  priceCents   Int // base price; a variant may override it
  baseMaterial String? // e.g. "Brass": honest material disclosure
  finish       String? // e.g. "Gold-plated"
  dimensions   String? // free text, e.g. "Drop length 4.5 cm"
  weightGrams  Float? // informational only (not money, so Float is fine)
  careNotes    String?
  contents     String[] // mystery boxes: list of what's inside
  isActive     Boolean           @default(true)
  isFeatured   Boolean           @default(false)
  categories   ProductCategory[]
  images       ProductImage[]
  variants     Variant[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

// Join table for the MANY-TO-MANY link between products and categories
// (a bridal set can be in both "Jewellery Sets" and "Bridal").
model ProductCategory {
  productId  String
  categoryId String
  sortOrder  Int      @default(0) // position of the product on that category page
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId]) // composite key: a product appears once per category
  @@index([categoryId, sortOrder])
}

model ProductImage {
  id                 String  @id @default(cuid())
  productId          String
  cloudinaryPublicId String
  alt                String // required: accessibility
  width              Int
  height             Int
  sortOrder          Int     @default(0)
  product            Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

// Every product has at least one variant. Non-ring products have a single
// "default" variant (label = null). Rings have one variant per size.
// STOCK LIVES HERE, not on Product.
model Variant {
  id                 String      @id @default(cuid())
  productId          String
  sku                String      @unique
  label              String? // e.g. "Size 7"; null for the default variant
  ringSize           String? // Canadian ring size, e.g. "6.5"
  priceCentsOverride Int?
  stock              Int         @default(0) // may go below 0 when an oversell is flagged
  isActive           Boolean     @default(true)
  sortOrder          Int         @default(0)
  product            Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItems         OrderItem[]

  @@unique([productId, ringSize])
}

// ─── Orders ─────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING // checkout started, not paid yet
  PAID // confirmed by a verified Stripe webhook, and ONLY by that
  SHIPPED
  EXPIRED // checkout session expired without payment
  REFUNDED
}

model Order {
  id          String      @id @default(cuid())
  orderNumber Int         @unique @default(autoincrement()) // shown as "MJ-1001"
  status      OrderStatus @default(PENDING)

  needsAttention  Boolean @default(false) // oversell, dispute, email failure…
  attentionReason String?

  // Customer & shipping details arrive from Stripe Checkout, so they are
  // empty while the order is PENDING. Address is a snapshot, not a link.
  email          String?
  customerName   String?
  phone          String?
  shipLine1      String?
  shipLine2      String?
  shipCity       String?
  shipProvince   String?
  shipPostalCode String?
  shipCountry    String?

  subtotalCents    Int
  shippingCents    Int     @default(0)
  taxCents         Int     @default(0)
  totalCents       Int
  currency         String  @default("cad")
  shippingRateName String?

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique

  paidAt                  DateTime?
  shippedAt               DateTime?
  carrier                 String?
  trackingNumber          String?
  // "Sent" timestamps make email sending safe to retry: send only if null.
  confirmationEmailSentAt DateTime?
  businessAlertSentAt     DateTime?
  shippedEmailSentAt      DateTime?

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, createdAt])
}

model OrderItem {
  id                   String  @id @default(cuid())
  orderId              String
  variantId            String
  // Snapshots, copied at checkout time:
  productNameSnapshot  String
  variantLabelSnapshot String?
  skuSnapshot          String
  imageSnapshot        String?
  unitPriceCents       Int
  quantity             Int
  order                Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant              Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

// ─── Safety ─────────────────────────────────────────────────────────────────

// One row per database saying which environment it is ("dev" or "production").
// Developer scripts refuse to write unless it matches what they expect, so a
// wrong connection string can't send dev data to production (or the reverse).
// Set once per Neon branch with `npm run db:mark`.
model EnvironmentMarker {
  id       Int      @id @default(1) // always 1: there is only ever one row
  name     String // "dev" | "production"
  markedAt DateTime @default(now())
}

// Log of Stripe webhook events we have processed: duplicate protection + audit trail.
model StripeEvent {
  id         String   @id // Stripe's event id, e.g. "evt_..."
  type       String
  receivedAt DateTime @default(now())
}
